# Use your institution's Moodle home URL, including any installation subdirectory.
MOODLE_URL=https://moodle.example.edu/
MOODLE_TOKEN=

# Optional: if your institution has a separate Moodle exam site.
MOODLE_EXAM_URL=
MOODLE_EXAM_TOKEN=
DIGEST_TIMEZONE=Europe/Berlin

# Required only for email delivery. Use your provider's SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
